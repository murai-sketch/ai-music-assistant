# --- 制作物（楽曲・アイデア・リファレンス・過去案）はGit管理外 ---
# このVaultの「枠組み」（04_Templates/, scripts/, ドキュメント類）のみMITでバージョン管理する。
# 歌詞・作品本体はアーティスト個人の情報に準じるため、Gitにコミットしない。
/01_Songs/*
/02_Seeds/*
/03_References/*
/05_Archives/*
!/01_Songs/.gitkeep
!/02_Seeds/.gitkeep
!/03_References/.gitkeep
!/05_Archives/.gitkeep

# --- 大容量音声・動画ファイル（歌詞動画・マスタリング出力含む） ---
*.wav
*.mp3
*.m4a
*.flac
*.mp4

# --- scripts/lyric_video, scripts/mastering のビルド成果物・中間ファイル ---
_work/

# --- DAWプロジェクトのバックアップファイル ---
*.als.bak
*.logicx.bak
*.flp.bak
*.ptxb
Backup/
Bounced Files/
*.asd

# --- Obsidian個人設定 ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS ---
.DS_Store
Thumbs.db
